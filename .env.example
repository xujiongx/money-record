# Supabase：项目 Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# 仅服务端使用，切勿提交到 Git 或暴露给前端
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mistral 对话（小布助手、本月小结），仅服务端
MISTRAL_API_KEY=
# 可选，默认 mistral-small-latest
# MISTRAL_MODEL=mistral-small-latest
# Node 请求 Mistral 的超时（毫秒），默认 120000
# MISTRAL_FETCH_TIMEOUT_MS=120000
# 仅 Mistral 请求使用的代理（优先于 HTTPS_PROXY，避免与其它工具冲突）
# MISTRAL_PROXY_URL=http://127.0.0.1:7890
# 若本机需代理才能访问 api.mistral.ai（与 Clash「HTTP 代理」端口一致，非 SOCKS 除非写 socks5://）
# HTTPS_PROXY=http://127.0.0.1:7890
# 若系统里 NO_PROXY=* 会导致 Node 直连失败，可在此覆盖为：NO_PROXY=localhost,127.0.0.1
